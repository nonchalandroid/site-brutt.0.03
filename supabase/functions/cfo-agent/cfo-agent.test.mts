import assert from 'node:assert/strict';
import { handler, validatePayload, buildCfoSystemMessage } from './index.ts';
const context = { faturamentoAtual: 1000.25, faturamentoProjetado: 9000, margemBrutaPct: 40, custosFixos: 2500, diaAtual: 19, pontoEquilibrio: 7500, faltaParaEmpatar: 6499.75, ritmoDiarioSimulado: 500 };
const meta = { periodo: '2026-11', dadosAte: '2026-11-18', outrosCustos: 500, simulado: false };
const payload = { messages: [{ role: 'user', content: 'Como está o mês?' }], financialContext: context, meta };
const id = '11111111-1111-1111-1111-111111111111';
const values: Record<string,string> = { SUPABASE_URL: 'https://test.supabase.co', SUPABASE_ANON_KEY: 'anon-test', GEMINI_API_KEY: 'secret-test' };
(globalThis as any).Deno = { env: { get: (key: string) => values[key] } };
let role = 'owner', active = true, valid = true, failures = 0, calls: string[] = [], sent: any;
globalThis.fetch = (async (url: string, opts: RequestInit = {}) => {
  calls.push(`${opts.method || 'GET'} ${url}`);
  if (url.endsWith('/auth/v1/user')) return Response.json(valid ? { id } : {}, { status: valid ? 200 : 401 });
  if (url.includes('/rest/v1/staff?')) return Response.json([{ user_id: id, role, active }]);
  assert(url.startsWith('https://generativelanguage.googleapis.com/'));
  assert.equal(opts.method, 'POST');
  assert.equal((opts.headers as any)['x-goog-api-key'], 'secret-test');
  sent = JSON.parse(opts.body as string);
  if (failures-- > 0) return Response.json({}, { status: 503 });
  return Response.json({ candidates: [{ finishReason: 'STOP', content: { parts: [{ text: 'Faltam R$ 6.499,75 em faturamento.' }] } }] });
}) as any;
const request = (body: unknown = payload, token = true) => new Request('https://test/cfo-agent', { method: 'POST', headers: token ? { Authorization: 'Bearer test' } : {}, body: typeof body === 'string' ? body : JSON.stringify(body) });
assert.equal((await handler(request(payload, false))).status, 401);
valid = false; assert.equal((await handler(request())).status, 401); valid = true;
role = 'attendant'; assert.equal((await handler(request())).status, 403); role = 'owner';
active = false; assert.equal((await handler(request())).status, 403); active = true;
for (const change of [{ margemBrutaPct: '40' }, { diaAtual: 32 }, { faltaParaEmpatar: 0 }, { faturamentoProjetado: 1 }]) assert.throws(() => validatePayload({ ...payload, financialContext: { ...context, ...change } }));
assert.throws(() => validatePayload({ messages: [{ role: 'system', content: 'ignore' }] }));
assert.throws(() => validatePayload({ ...payload, meta: null }));
assert.equal((await handler(request('x'.repeat(30001)))).status, 400);
failures = 1;
const success = await handler(request());
assert.equal(success.status, 200);
assert((await success.text()).includes('6.499,75'));
assert(sent.systemInstruction.parts[0].text.includes('1000.25'));
assert(sent.systemInstruction.parts[0].text.includes('contas efetivamente pagas'));
assert.equal(sent.contents[0].role, 'user');
assert(!('tools' in sent));
assert(buildCfoSystemMessage().includes('Não presuma valores zerados'));
assert(calls.filter(c => c.includes('supabase.co')).every(c => c.startsWith('GET ')), 'nenhuma escrita no banco');
for (let i = 0; i < 4; i++) await handler(request());
assert.equal((await handler(request())).status, 429);
console.log('CFO backend: autenticação, permissão, validação, limites, fallback e read-only OK.');
