import assert from 'node:assert/strict';
import { addCalendarDays, brazilDate, financialEstimate, parseAmount, validateCashContext } from '../admin/cfo-financial.js';
assert.equal(brazilDate(new Date('2026-12-01T01:00:00Z')), '2026-11-30');
assert.equal(addCalendarDays('2026-12-20', 15), '2027-01-04');
assert.equal(addCalendarDays('2028-02-15', 15), '2028-03-01');
assert.equal(addCalendarDays('2026-01-31', 30), '2026-03-02');
assert.throws(() => addCalendarDays('2026-02-30', 0));
assert.equal(parseAmount('1234,56'), 1234.56); assert.equal(parseAmount('-0,25'), -.25);
for (const value of ['', '1.234,56', 'NaN', '1e5', '1,234', 'Infinity']) assert.throws(() => parseAmount(value));
for (const value of [{ saldoRealCaixaHoje: '100' }, { saldoRealCaixaHoje: Infinity }, { saldoRealCaixaHoje: 1.234 }, { simulacaoDespesa: { valor: 0, prazoDias: 15 } }, { simulacaoDespesa: { valor: 1, prazoDias: 21 } }]) assert.throws(() => validateCashContext(value));
const bill = (date: string, valor: number, status = 'aberto') => ({ dataVencimento: date, valor, status });
const bills = [bill('2026-11-01', 10), bill('2026-11-20', .1), bill('2026-11-30', .2), bill('2026-12-01', 40), bill('2026-12-20', 50), bill('2026-11-21', 100, 'pago')];
const estimate = financialEstimate({ saldoRealCaixaHoje: 100, simulacaoDespesa: { valor: 20, prazoDias: 15 } }, bills, '2026-11-20');
assert.equal(estimate.boletosProximos10Dias, 10.3);
assert.equal(estimate.folgaFinanceiraCondicionada, 89.7);
assert.equal(estimate.simulacaoDespesa.dataVencimento, '2026-12-05');
assert.equal(estimate.simulacaoDespesa.janelaCritica, true);
assert.equal(estimate.simulacaoDespesa.boletosAteHorizonte, 50.3);
assert.equal(estimate.simulacaoDespesa.folgaAposDespesa, 29.7);
assert.equal(financialEstimate({ saldoRealCaixaHoje: 0 }, bills, '2026-11-20').folgaFinanceiraCondicionada, -10.3);
assert.equal(financialEstimate({}, bills, '2026-11-20').folgaFinanceiraCondicionada, null);
assert.equal(financialEstimate({ saldoRealCaixaHoje: -10 }, bills, '2026-11-20').folgaFinanceiraCondicionada, -20.3);
const immediate = financialEstimate({ saldoRealCaixaHoje: 100, simulacaoDespesa: { valor: 20, prazoDias: 0 } }, bills, '2026-11-20');
assert.equal(immediate.simulacaoDespesa.reservaAte, '2026-11-30');
assert.equal(immediate.simulacaoDespesa.folgaAposDespesa, 69.7);
for (const [date, expected] of [['2026-11-01', true], ['2026-11-10', true], ['2026-11-11', false]]) assert.equal(financialEstimate({ simulacaoDespesa: { valor: 1, prazoDias: 0 } }, [], date).simulacaoDespesa.janelaCritica, expected);
assert.throws(() => financialEstimate({ saldoRealCaixaHoje: 100, saldoInformadoEm: '2026-11-19' }, [], '2026-11-20'));
assert.equal(financialEstimate({ saldoRealCaixaHoje: 100, folgaFinanceiraCondicionada: 999999 }, [], '2026-11-20').folgaFinanceiraCondicionada, 100);
assert.deepEqual(validateCashContext({ simulacaoDespesa: { valor: 100, prazoDias: 15, dataVencimento: '2099-01-01' } }).simulacaoDespesa, { valor: 100, prazoDias: 15 });
console.log('CFO simulação: datas, viradas de mês/ano, ano bissexto, centavos, horizontes, saldo ausente/zero/negativo e validação OK.');
